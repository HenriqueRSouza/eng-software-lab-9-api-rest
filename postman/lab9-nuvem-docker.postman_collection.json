          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Mensagem de item não encontrado\", () => pm.expect(pm.response.json().error).to.eql(\"Item not found\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{flask_azure_url}}/items/{{flask_item_id}}"
          },
          "response": []
        },
        {
          "name": "Listar itens no final",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Item removido não aparece na lista\", () => {",
                  "    const id = Number(pm.collectionVariables.get(\"flask_item_id\"));",
                  "    pm.expect(pm.response.json().items.map(i => i.id)).to.not.include(id);",
                  "});"
                ]
              }
            }
          ],
