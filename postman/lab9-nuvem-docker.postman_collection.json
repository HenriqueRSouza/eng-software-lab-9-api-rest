    {
      "name": "9.4 - Flask na Azure",
      "item": [
        {
          "name": "Listar itens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Retorna a lista de itens\", () => {",
                  "    const items = pm.response.json().items;",
                  "    pm.expect(items).to.be.an(\"array\");",
                  "    items.forEach(i => pm.expect(i).to.have.all.keys(\"id\", \"name\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{flask_azure_url}}/items"
          },
          "response": []
        },
        {
          "name": "Buscar item 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Retorna o item de id 1\", () => pm.expect(pm.response.json().item.id).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{flask_azure_url}}/items/1"
          },
          "response": []
        },
        {
          "name": "Buscar item inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Mensagem de item não encontrado\", () => pm.expect(pm.response.json().error).to.eql(\"Item not found\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{flask_azure_url}}/items/999999"
          },
          "response": []
        },
        {
          "name": "Criar item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const item = pm.response.json().item;",
                  "pm.test(\"Item criado com o nome enviado\", () => {",
                  "    pm.expect(item.id).to.be.a(\"number\");",
                  "    pm.expect(item.name).to.eql(\"Item criado pelo Postman\");",
                  "});",
                  "pm.collectionVariables.set(\"flask_item_id\", item.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{flask_azure_url}}/items",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Item criado pelo Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Criar item sem name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Informa que o campo name é obrigatório\", () => pm.expect(pm.response.json().error).to.eql(\"Field 'name' is required\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
