              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Mensagem de remoção\", () => pm.expect(pm.response.json().message).to.eql(\"Item deleted\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
